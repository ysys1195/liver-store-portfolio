# Copy this file to .env for local development.
# These credentials are for the local Docker database only.
POSTGRES_USER=liver_store
POSTGRES_PASSWORD=liver_store_password
POSTGRES_DB=liver_store
POSTGRES_PORT=5432

# Prisma runtime connection. Production: Neon pooled URL with TLS.
DATABASE_URL=postgresql://liver_store:liver_store_password@localhost:5432/liver_store?schema=public

# Optional direct connection for Prisma CLI (migration/status).
# Local: leave empty to use DATABASE_URL. Production operations: set the Neon
# direct URL for the SAME branch/database/role, with sslmode=verify-full.
# Keep real Production values in a secret manager, never in this file.
DIRECT_URL=

# Server-only credentials used by the Next.js request boundary.
# Replace these sample values in .env. Do not prefix them with NEXT_PUBLIC_.
# The default development command binds to loopback before disabling Basic auth.
# Set this to false before intentionally exposing the dev server to a LAN.
# Production and Preview always require valid credentials.
DISABLE_BASIC_AUTH=true
BASIC_AUTH_USER=portfolio_viewer
BASIC_AUTH_PASSWORD=replace_with_a_strong_password
